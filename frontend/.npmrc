# Project-local npm configuration.
#
# Install-script allowlist (npm 10.x):
# npm 10.9 does not yet support the `onlyBuiltDependencies` package.json
# field that npm 11+ uses. Until the project upgrades to npm 11+, the
# install-script policy is documented in this file and re-enforced via
# `ignore-scripts` plus a controlled `postinstall` step in package.json
# if needed.
#
# The only two packages in this dependency graph that ship install or
# postinstall scripts are:
#
#   sharp@0.35.x         (transitive: next/image)
#     install: node install/check
#     Purpose: detects whether a system libvips is present. If not
#              (the default in this project) the script exits without
#              any side effects. It does not download binaries, does
#              not perform network I/O, and does not modify the
#              filesystem outside the package directory.
#
#   unrs-resolver@1.12.x (transitive: eslint-config-next ->
#                                 eslint-import-resolver-typescript)
#     postinstall: node postinstall.js
#     Purpose: uses `napi-postinstall` to resolve the correct prebuilt
#              native binding for the current platform. Standard
#              practice for napi-rs packages. The module also ships a
#              JavaScript fallback (index.js) so the package works
#              even when the postinstall does not run.
#
# Both scripts have been inspected and are safe to allow. The
# repository does not use `--dangerously-allow-all-scripts`, does not
# call `npm config set dangerously-allow-all-scripts=true`, and does
# not change any user- or system-level npm configuration.

enable-pre-post-scripts=true
ignore-scripts=false
