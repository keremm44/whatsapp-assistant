# Backend API base URL.
# HTTPS is required outside local loopback development; localhost/127.0.0.1/::1 may use HTTP.
NEXT_PUBLIC_API_BASE_URL=

# Supabase project URL (public, browser-visible).
# HTTPS is required outside local loopback development.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (public, browser-visible). Never use the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for metadata (Open Graph, canonical links, etc.).
# Local development may omit this and fall back to http://localhost:3000.
# Production deployments should set an explicit HTTPS URL.
NEXT_PUBLIC_SITE_URL=
