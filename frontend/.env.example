# Backend API base URL (e.g. http://127.0.0.1:8000)
NEXT_PUBLIC_API_BASE_URL=

# Supabase project URL (public, browser-visible)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (public, browser-visible). Never use the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for metadata (Open Graph, canonical links, etc.).
# Optional. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=
