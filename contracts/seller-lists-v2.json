              "display_issue_type": "Adet sınırı talebi",
              "seller_action_required": true
            }
          ],
          "has_more": false,
          "next_cursor": null
        },
        "fields": {
          "items": "list — legacy return list item shape'i + customer_phone/display_issue_type/seller_action_required enrichment (legacy'le aynı)",
          "has_more": "bool",
          "next_cursor": "string | null"
        },
        "error_cases": {
          "401": "Missing/invalid Bearer token",
          "403": "Seller olmayan rol",
          "422": "Geçersiz cursor (seller_list_v2_cursor_invalid) veya geçersiz issue_type (seller_list_v2_validation_error)",
          "503": "Database unavailable (seller_list_v2_returns_unavailable)"
        }
      }
    },
    "unanswered": {
      "endpoint": "GET /seller/unanswered-questions/v2",
      "auth": "require_seller (Bearer, seller_id tenant scoped via AuthContext)",
      "keyset_order": "(last_seen_at DESC, id DESC)",
      "legacy_equivalent": "GET /seller/unanswered-questions (offset, korunur)",
      "request": {
        "query": {
          "view": "'all' (default) | 'action_required' | 'answered' | 'dismissed'",
          "limit": "1..100, default 20",
          "cursor": "optional; önceki sayfanın next_cursor değeri"
        }
      },
      "response": {
        "success_example": {
          "items": [
            {
              "id": 61,
              "question": "Kargoya ne zaman verilir?",
              "status": "OPEN",
