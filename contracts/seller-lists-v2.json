{
  "schema_version": 1,
  "description": "Seller list v2 cursor (keyset) pagination contract. Legacy offset endpointleri ve /seller/v2/* cursor queue'ları aynen korunur; bu yüzey tamamen ek (additive) bir contracttir. Response her zaman TAMAMEN {items, has_more, next_cursor} anahtarlarını içerir.",
  "cursor_contract": {
    "type": "opaque signed token (query param: cursor)",
    "encoding": "base64url(JSON payload + HMAC-SHA256(payload)[:16]), padding'siz",
    "payload": {
      "v": "1 (cursor sürümü)",
      "s": "seller_id (int) — token satıcıya imzalı olarak bağlıdır",
      "q": "queue (str) — token endpoint'e bağlıdır",
      "f": "filter fingerprint (sha256[:24]) — token filtre bağlamına bağlıdır",
      "p": "position (object) — keyset konumu; endpoint'e göre (time, id) veya conversation read-model rank seti"
    },
    "max_length": 2048,
    "secret": "PAGINATION_CURSOR_SECRET env var'ı (production'da tanımlı değilse encode/decode fail-closed)",
    "fail_closed_cases": [
      "başka satıcının token'ı (422 seller_list_v2_cursor_invalid)",
      "başka queue/endpoint'ten token (422)",
      "farklı filtre bağlamında token (422)",
      "bozuk/tamper'lanmış/uzun token (422)",
      "legacy /seller/orders cursor formatı (422)"
    ]
  },
  "endpoints": {
    "orders": {
      "endpoint": "GET /seller/orders/v2",
      "auth": "require_seller (Bearer, seller_id tenant scoped via AuthContext)",
      "keyset_order": "(updated_at DESC, id DESC)",
      "legacy_equivalent": "GET /seller/orders (offset, korunur)",
      "request": {
        "query": {
          "view": "'all' (default) | 'action_required' | 'collecting'",
          "status": "optional; legacy sipariş durumlarından biri (VALID_ORDER_STATUSES)",
          "product_id": "optional int >= 1",
          "image_missing": "optional bool",
          "customer_id": "optional int >= 1",
          "external_order_number": "optional str <= 100",
          "limit": "1..100, default 20",
          "cursor": "optional; önceki sayfanın next_cursor değeri"
        }
      },
      "response": {
        "success_example": {
          "items": [
            {
              "id": 41,
              "external_order_number": "TR123456",
              "product_id": 3,
              "product_name_snapshot": "Kişiye Özel Kupa",
              "customer_id": 22,
              "customer_phone_snapshot": "+905321112233",
              "status": "COLLECTING",
              "display_status": "Bilgi toplanıyor",
              "image_message_id": 104,
              "has_image": true,
              "custom_text": "İyi ki doğdun Deniz",
              "review_reason_code": null,
              "review_reason_note": null,
              "version": 4,
              "created_at": "2026-08-10T12:00:00+00:00",
              "updated_at": "2026-08-10T12:30:00+00:00",
              "completed_at": null,
              "seller_action_required": false
            }
          ],
          "has_more": true,
          "next_cursor": "eyJzIjoyMX0_signature_part"
        },
        "fields": {
          "items": "list — item shape legacy /seller/orders order summary'siyle birebir aynı",
          "has_more": "bool — daha fazla sayfa var mı",
          "next_cursor": "string | null — has_more=false iken null; sonraki sayfa için query param"
        },
        "error_cases": {
          "401": "Missing/invalid Bearer token",
          "403": "Seller olmayan rol",
          "422": "Geçersiz/abancı/filtre uyuşmayan/tamper'lanmış cursor (seller_list_v2_cursor_invalid) veya geçersiz filter değeri (seller_list_v2_validation_error)",
          "503": "Database unavailable (seller_list_v2_orders_unavailable) veya next_cursor üretilemedi (seller_list_v2_page_unavailable)"
        }
      }
    },
    "returns": {
      "endpoint": "GET /seller/return-issue-requests/v2",
      "auth": "require_seller (Bearer, seller_id tenant scoped via AuthContext)",
      "keyset_order": "(updated_at DESC, id DESC)",
      "legacy_equivalent": "GET /seller/return-issue-requests (offset, korunur)",
      "request": {
        "query": {
          "view": "'all' (default) | 'action_required' | 'collecting' | 'handled'",
          "customer_id": "optional int >= 1",
          "issue_type": "optional; canonical issue_type (RETURN_ISSUE_TYPES)",
          "external_order_number": "optional str <= 100 (external_order_number_snapshot eşleşmesi)",
          "limit": "1..100, default 20",
          "cursor": "optional; önceki sayfanın next_cursor değeri"
        }
      },
      "response": {
        "success_example": {
          "items": [
            {
              "id": 51,
