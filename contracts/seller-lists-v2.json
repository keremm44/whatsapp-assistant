        },
        "fields": {
          "items": "list — legacy unanswered group summary shape'iyle birebir aynı",
          "has_more": "bool",
          "next_cursor": "string | null"
        },
        "error_cases": {
          "401": "Missing/invalid Bearer token",
          "403": "Seller olmayan rol",
          "422": "Geçersiz cursor (seller_list_v2_cursor_invalid)",
          "503": "Database unavailable (seller_list_v2_unanswered_unavailable)"
        }
      }
    },
    "conversations": {
      "endpoint": "GET /seller/conversations/v2",
      "auth": "require_seller (Bearer, seller_id tenant scoped via AuthContext)",
      "keyset_order": "conversation cursor read model (migration 033: get_seller_conversation_list_cursor) — paused_rank DESC, attention_rank DESC, sort_at DESC, customer_id DESC",
      "legacy_equivalent": "GET /seller/conversations (offset, korunur)",
      "request": {
