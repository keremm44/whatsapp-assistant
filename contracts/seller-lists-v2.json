  "frontend_rules": [
    "Yeni sayfalar mevcut sonuçlara EKLENİR (append); sabit limitle sonuç gizlenmez",
    "Filtre değişiminde cursor sıfırlanır (yeni ilk sayfa, cursor gönderilmez)",
    "has_more=false iken 'Daha fazla göster' gösterilmez",
    "next_cursor yalnızca aynı filtre bağlamıyla yeniden kullanılabilir"
  ],
  "backward_compatible": true
}
