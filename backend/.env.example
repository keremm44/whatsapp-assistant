# Runtime
# APP_ENV yalnızca development, test veya production olabilir.
APP_ENV=development
APP_VERSION=0.4.0
# DEBUG, INFO, WARNING, ERROR veya CRITICAL.
LOG_LEVEL=INFO

# Sentry backend/worker operational monitoring (opsiyonel).
# SENTRY_DSN boşsa entegrasyon tamamen kapalıdır.
# Request body ve varsayılan PII gönderilmez; tracing varsayılan olarak kapalıdır.
# Aynı DSN API, WhatsApp worker ve bağımsız ops check tarafından kullanılabilir.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# WhatsApp Cloud API webhook (Meta/deploy kurulana kadar boş bırakılır).
# VERIFY_TOKEN Meta webhook GET doğrulaması içindir.
# APP_SECRET yalnız backend secret store'da tutulur; browser/frontend'e verilmez.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Runtime dispatch varsayılan kapalıdır. Worker bu değer false ise queue claim
# etmeden çıkar. Yalnız repository migration zinciri hedef DB ile tam parity
# durumundayken ve worker deployment doğrulandıktan sonra açılır.
# true olduğunda bağımsız ops check son iki dakikada worker heartbeat bekler.
WHATSAPP_RUNTIME_ENABLED=false

# WhatsApp outbound transport ayrıca kapalıdır. WHATSAPP_SEND_ENABLED=true için
# WHATSAPP_RUNTIME_ENABLED=true zorunludur. ACCESS_TOKEN yalnız backend secret
# store'da tutulur. Graph API sürümü bilerek varsayılan verilmez; Meta/deploy
# kurulumu sırasında desteklenen sürüm açıkça seçilir.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Supabase backend (service key yalnızca backend ortamında tutulur).
# Production ortamı SUPABASE_URL ve SUPABASE_SERVICE_KEY olmadan başlamaz;
# SUPABASE_URL production'da geçerli bir HTTPS URL olmalıdır.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Seller list v2 cursor imza sırrı (HMAC-SHA256). En az 16 karakter.
# Production ortamında tanımlı değilse v2 cursor endpoint'leri fail-closed
# çalışır (cursor üretilmez/çözümlenmez). Development'ta boş bırakılırsa
# yerleşik geliştirme sırrı kullanılır (yalnızca yerel kullanım).
PAGINATION_CURSOR_SECRET=

# Niyet sınıflandırıcı. Production model değişikliğinden/deploydan önce:
# python -m scripts.run_ai_eval
# komutu golden dataset gate'ini geçmelidir. Anahtar yoksa runtime yalnız kesin
# deterministic fallback kalıplarını kullanır, belirsiz mesajları unclear bırakır.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend originleri virgülle ayrılır
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seller medya proxy'sinin güvendiği sağlayıcı hostları (virgülle ayrılır,
# yalnızca host adı; boşsa medya indirme tamamen kapalıdır — fail-closed)
MEDIA_ALLOWED_HOSTS=

# Authenticated endpoint rate limiting (seller/* ve admin/* path'leri).
# Dakikada maksimum istek sayısı. 0 veya boş bırakılırsa varsayılan (120) kullanılır.
# Bu process-local bir limittir; multi-worker deploy için edge-layer limit önerilir.
RATE_LIMIT_AUTHENTICATED=120

# Yerel geliştirme endpointleri varsayılan olarak kapalıdır.
ENABLE_DEV_ENDPOINTS=false
INTERNAL_API_TOKEN=

# Canlı auth kontrol scripti
LOCAL_API_URL=http://127.0.0.1:8000
