# Runtime
# APP_ENV yalnızca development, test veya production olabilir.
APP_ENV=development
APP_VERSION=0.4.0
LOG_LEVEL=INFO

# Sentry backend error monitoring (opsiyonel).
# SENTRY_DSN boşsa entegrasyon tamamen kapalıdır.
# Request body ve varsayılan PII gönderilmez; tracing varsayılan olarak kapalıdır.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# WhatsApp Cloud API webhook (Meta/deploy kurulana kadar boş bırakılır).
# VERIFY_TOKEN Meta webhook GET doğrulaması içindir.
# APP_SECRET yalnız backend secret store'da tutulur; browser/frontend'e verilmez.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Runtime dispatch varsayılan kapalıdır. Yalnız migration 036-037 hedef DB'de
# uygulanıp doğrulandıktan sonra kontrollü olarak açılır.
WHATSAPP_RUNTIME_ENABLED=false

# WhatsApp outbound transport ayrıca kapalıdır. ACCESS_TOKEN yalnız backend
# secret store'da tutulur. Graph API sürümü bilerek varsayılan verilmez;
# Meta/deploy kurulumu sırasında desteklenen sürüm açıkça seçilir.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Supabase backend (service key yalnızca backend ortamında tutulur).
# Production ortamı SUPABASE_URL ve SUPABASE_SERVICE_KEY olmadan başlamaz;
# SUPABASE_URL production'da geçerli bir HTTPS URL olmalıdır.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Seller list v2 cursor imza sırrı (HMAC-SHA256). En az 16 karakter.
# Production ortamında tanımlı değilse v2 cursor endpoint'leri fail-closed
# çalışır (cursor üretilmez/çözümlenmez). Development'ta boş bırakılırsa
# yerleşik geliştirme sırrı kullanılır (yalnızca yerel kullanım).
PAGINATION_CURSOR_SECRET=

# Niyet sınıflandırıcı
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend originleri virgülle ayrılır
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seller medya proxy'sinin güvendiği sağlayıcı hostları (virgülle ayrılır,
# yalnızca host adı; boşsa medya indirme tamamen kapalıdır — fail-closed)
MEDIA_ALLOWED_HOSTS=

# Yerel geliştirme endpointleri varsayılan olarak kapalıdır.
ENABLE_DEV_ENDPOINTS=false
INTERNAL_API_TOKEN=

# Canlı auth kontrol scripti
LOCAL_API_URL=http://127.0.0.1:8000
